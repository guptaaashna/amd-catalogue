generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vendor {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  email     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  imports   Import[]
  auditLogs AuditLog[]

  @@index([name])
}

model Product {
  id           String               @id @default(uuid()) @db.Uuid
  vendorId     String               @db.Uuid
  sku          String
  title        String
  description  String               @default("")
  category     String
  price        Decimal              @db.Decimal(12, 2)
  currency     String               @default("USD") @db.Char(3)
  attributes   Json                 @default("{}")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  vendor       Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  suggestions  AiSuggestion[]
  importRows   ImportOriginalRow[]
  auditLogs    AuditLog[]

  @@unique([vendorId, sku])
  @@index([vendorId, category])
  @@index([title])
}

model Import {
  id           String              @id @default(uuid()) @db.Uuid
  vendorId     String              @db.Uuid
  filename     String
  status       String
  rowCount     Int
  errorCount   Int                 @default(0)
  createdAt    DateTime            @default(now())
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  originalRows ImportOriginalRow[]
  auditLogs    AuditLog[]

  @@index([vendorId, createdAt])
}

model ImportOriginalRow {
  id        String   @id @default(uuid()) @db.Uuid
  importId  String   @db.Uuid
  rowNumber Int
  rawData   Json
  error     String?
  productId String?  @db.Uuid
  createdAt DateTime @default(now())
  import    Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([productId])
}

model ProductTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  locale      String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

model AiSuggestion {
  id            String           @id @default(uuid()) @db.Uuid
  productId     String?          @db.Uuid
  field         String
  originalValue Json?
  proposedValue Json
  rationale     String?
  status        SuggestionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  auditLogs     AuditLog[]

  @@index([productId, status])
}

model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  vendorId     String?       @db.Uuid
  productId    String?       @db.Uuid
  importId     String?       @db.Uuid
  suggestionId String?       @db.Uuid
  action       String
  actor        String        @default("system")
  details      Json
  createdAt    DateTime      @default(now())
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  import       Import?       @relation(fields: [importId], references: [id], onDelete: SetNull)
  suggestion   AiSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([productId, createdAt])
}
